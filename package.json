{
  "name": "publiccode-editor",
  "version": "2.2.0",
  "license": "AGPL-3.0-or-later",
  "description": "[License](./LICENSE)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predev": "tsx scripts/buildWasm.ts --if-needed development",
    "prebuild": "tsx scripts/buildWasm.ts --if-needed production && npm run build:licenses",
    "build:providers-oembed": "tsx scripts/getProvidersOembed.ts src/generated/providers-oembed.json",
    "build:licenses": "mkdir -p src/generated && tsx scripts/genLicenseList.ts src/generated/licenses.json",
    "sync:jsonschema": "tsx scripts/syncJsonSchema.ts",
    "parity": "npm run build:wasm && tsx scripts/parity.ts",
    "build:wasm": "tsx scripts/buildWasm.ts",
    "serve": "rm -rf dist; npm run build && http-server dist",
    "format": "prettier --write 'src/**/*.{ts,tsx,scss,css,json}' ",
    "test": "jest --passWithNoTests",
    "deploy": "gh-pages -u 'Deploy Bot <no-reply@teamdigitale.governo.it>' -d dist"
  },
  "keywords": [
    "publiccode",
    "publicode",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:italia/publiccode-editor.git"
  },
  "publiccodeYml": {
    "latestVersion": "0.7.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^.+.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "<rootDir>/src/__mocks__/svgImportMock.js",
      "^worker-loader!.*": "<rootDir>/src/__mocks__/workerMock.js"
    },
    "transform": {
      "^.+\\.(t|j)sx?$": "@swc/jest"
    }
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.2.3",
    "accessible-autocomplete": "^3.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bootstrap": "^5.3.8",
    "bootstrap-italia": "^2.18.3",
    "copy-to-clipboard": "^4.0.2",
    "countries-list": "^3.4.1",
    "date-fns": "^4.4.0",
    "design-react-kit": "^5.10.0",
    "i18next": "^26.7.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "js-yaml": "^5.5.0",
    "locale-codes": "^2.0.0",
    "lodash": "^4.18.1",
    "mime-db": "^1.54.0",
    "mitt": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.91.0",
    "react-hook-form-persist": "^3.0.0",
    "react-i18next": "^17.1.13",
    "react-resizable-panels": "^4.19.0",
    "react-widgets": "^5.8.6",
    "type-fest": "^5.10.0",
    "validator": "^13.15.35",
    "yaml": "^2.9.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@peterek/vite-plugin-favicons": "^2.1.0",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/golang-wasm-exec": "^1.15.2",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.17.27",
    "@types/mime-db": "^1.43.6",
    "@types/node": "^26.6.6",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^31.0.0",
    "node-fetch": "^3.3.2",
    "prettier": "^3.9.10",
    "swc-loader": "^0.2.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  }
}
