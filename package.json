{
  "name": "publiccode-editor",
  "version": "2.2.0",
  "license": "AGPL-3.0-or-later",
  "description": "[License](./LICENSE)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predev": "tsx scripts/buildWasm.ts --if-needed development",
    "prebuild": "tsx scripts/buildWasm.ts --if-needed production && npm run build:licenses",
    "build:providers-oembed": "tsx scripts/getProvidersOembed.ts src/generated/providers-oembed.json",
    "build:licenses": "mkdir -p src/generated && tsx scripts/genLicenseList.ts src/generated/licenses.json",
    "parity": "npm run build:wasm && tsx scripts/parity.ts",
    "build:wasm": "tsx scripts/buildWasm.ts",
    "serve": "rm -rf dist; npm run build && http-server dist",
    "format": "prettier --write 'src/**/*.{ts,tsx,scss,css,json}' ",
    "test": "jest --passWithNoTests",
    "deploy": "gh-pages -u 'Deploy Bot <no-reply@teamdigitale.governo.it>' -d dist"
  },
  "keywords": [
    "publiccode",
    "publicode",
    "editor"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:italia/publiccode-editor.git"
  },
  "publiccodeYml": {
    "latestVersion": "0.7.0"
  },
  "jest": {
    "moduleNameMapper": {
      "^.+.(css|styl|less|sass|scss|png|jpg|ttf|woff|woff2)$": "<rootDir>/src/__mocks__/svgImportMock.js",
      "^worker-loader!.*": "<rootDir>/src/__mocks__/workerMock.js",
      "^publiccode-schema$": "<rootDir>/node_modules/publiccode-schema/dist/index.js",
      "^publiccode-schema/validator$": "<rootDir>/node_modules/publiccode-schema/dist/validator/index.js"
    },
    "transform": {
      "^.+\\.(t|j)sx?$": "@swc/jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!publiccode-schema/)"
    ]
  },
  "dependencies": {
    "@uiw/react-md-editor": "^4.1.1",
    "accessible-autocomplete": "^3.0.1",
    "bootstrap": "^5.3.6",
    "bootstrap-italia": "^2.18.2",
    "copy-to-clipboard": "^3.3.3",
    "countries-list": "^3.0.6",
    "date-fns": "^4.1.0",
    "design-react-kit": "^5.10.0",
    "i18next": "^23.2.2",
    "i18next-browser-languagedetector": "^7.2.0",
    "js-yaml": "^4.3.2",
    "locale-codes": "^1.3.1",
    "lodash": "^4.18.1",
    "mime-db": "^1.53.0",
    "mitt": "^3.0.1",
    "publiccode-schema": "^0.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.45.0",
    "react-hook-form-persist": "^3.0.0",
    "react-i18next": "^15.0.0",
    "react-resizable-panels": "^2.1.7",
    "react-widgets": "^5.8.4",
    "type-fest": "^4.10.3",
    "validator": "^13.15.22",
    "yaml": "^2.8.4",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@peterek/vite-plugin-favicons": "^2.1.0",
    "@swc/core": "^1.3.66",
    "@swc/jest": "^0.2.26",
    "@testing-library/jest-dom": "^5.16.5",
    "@types/golang-wasm-exec": "^1.15.0",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": "^4.14.195",
    "@types/mime-db": "^1.43.5",
    "@types/node": "^24.13.2",
    "@types/node-fetch": "^2.6.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/validator": "^13.7.17",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "gh-pages": "^5.0.0",
    "globals": "^15.9.0",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "node-fetch": "^3.3.2",
    "prettier": "^3.6.2",
    "swc-loader": "^0.2.3",
    "ts-node": "^10.9.1",
    "tsx": "^4.19.3",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.11.0",
    "vite": "^8.1.0"
  }
}
