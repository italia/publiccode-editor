# Comma separated Country-Specific sections (https://yml.publiccode.tools/country.html)
# to display by default when the editor is loaded.
#
# Valid identifiers: "all", "none" or "italy"
#
# (default: "none")
VITE_DEFAULT_COUNTRY_SECTIONS=none

# Validator implementation: "wasm" (publiccode-parser-go compiled to
# WebAssembly) or "ajv" (JSON Schema, experimental).
#
# (default: "wasm")
VITE_VALIDATOR=wasm

# Experimental country sections to enable: comma-separated ids (ISO 3166-1
# alpha-3, lowercase, e.g. "nld") of publiccode-json-schema country packages
# that have a section the standard doesn't define. publiccode-parser-go and
# the catalog reject those sections, so they only work with VITE_VALIDATOR=ajv
# and are ignored otherwise.
#
# (default: none)
VITE_EXPERIMENTAL_SECTIONS=

VITE_REPOSITORY=
VITE_ELASTIC_URL=
VITE_VALIDATOR_URL=
VITE_VALIDATOR_REMOTE_URL=
VITE_DEFAULT_COUNTRY=
VITE_FALLBACK_LANGUAGE=
