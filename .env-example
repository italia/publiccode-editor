# Comma separated Country-Specific sections (https://yml.publiccode.tools/country.html)
# to display by default when the editor is loaded.
#
# Valid identifiers: "all", "none" or "italy"
#
# (default: "none")
VITE_DEFAULT_COUNTRY_SECTIONS=none

# URL of the editor's source code, linked as "Source code" in the header.
#
# (default: "https://github.com/italia/publiccode-editor")
VITE_REPOSITORY=

# URL of a sample publiccode.yml, shown as placeholder in the import-from-URL field.
#
# (default: "https://raw.githubusercontent.com/italia/publiccode-editor/main/publiccode.yml")
VITE_SAMPLE_YAML_URL=

VITE_ELASTIC_URL=
VITE_VALIDATOR_URL=
VITE_VALIDATOR_REMOTE_URL=
VITE_DEFAULT_COUNTRY=
VITE_FALLBACK_LANGUAGE=
